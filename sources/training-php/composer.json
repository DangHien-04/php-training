{
    "name": "training-php/redis-localstorage-app",
    "description": "PHP training application with Redis and localStorage integration",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "predis/predis": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}

